# ============================================================================
# Corretor de Redação ENEM com Google ADK — Variáveis de Ambiente (.env)
# Copie para `.env` e preencha sua chave:  cp .env.example .env
# ============================================================================

# --- Provedor principal: Gemini (Google AI Studio — free tier) ---
GOOGLE_API_KEY=sua_chave_aqui

# Modelo padrão (exemplos):
#   Gemini nativo:   gemini-3.5-flash | gemini-3.5-flash-lite | gemini-2.5-flash
#   Ollama local:    ollama_chat/qwen2.5:3b | ollama_chat/gemma3:4b
#   Groq (LiteLLM):  groq/llama-3.3-70b-versatile
#   OpenRouter:      openrouter/meta-llama/llama-3.3-70b-instruct:free
ENEM_MODELO=gemini-3.5-flash

# --- Parâmetros de geração e execução ---
ENEM_TEMPERATURA=0.1
# ENEM_SEMENTE=42
ENEM_TENTATIVAS_MODELO=4
# Desligue (false) ao usar Ollama local com pouca RAM ou limites rígidos de RPM:
ENEM_PARALELO=true
ENEM_TENTATIVAS_COMPETENCIA=2
# Janela de contexto explícita para modelos Ollama via LiteLLM (evita truncamento silencioso):
ENEM_NUM_CTX=8192

# --- Heurísticas de contagem de linhas (texto digitado -> folha de 30 linhas) ---
ENEM_CARACTERES_POR_LINHA=70
ENEM_LINHAS_MINIMAS=8
ENEM_LINHAS_MAXIMAS=30

# --- LanguageTool (opcional para apoio à C1) ---
LANGUAGETOOL_HABILITADO=false
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# --- Persistência local de execuções (data/execucoes/historico.jsonl) ---
ENEM_SALVAR_EXECUCOES=true
